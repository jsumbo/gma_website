rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Public site content is readable by anyone; only users listed in `admins` can change it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // One doc per admin, keyed by their Firebase Auth UID. Managed only from the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /athletes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /managementTeam/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form submissions. The website's /api/contact route creates them (after its own validation
    // and spam checks); the rules re-check the shape so nothing else can be written here. Admin-only reads.
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subject in ['representation', 'partnership', 'brand', 'media', 'other']
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && request.resource.data.createdAt < request.time + duration.value(5, 'm');
      allow read, update, delete: if isAdmin();
    }

    // Anything not listed above is denied by default.
  }
}
